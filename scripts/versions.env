#!/usr/bin/env bash
# 本 skill 验证过的版本矩阵。改动任何一项都要重跑 scripts/verify.sh 并同步 references/compatibility.md。

export CWGO_VERSION="v0.1.3"
export CWGO_MODULE="github.com/dej4vu/cwgo"
export KITEX_GENERATOR_VERSION="v0.16.3" # cwgo 内置的生成器版本
export HZ_VERSION="v0.9.7"                # cwgo 内置的 hz 版本
export KITEX_RUNTIME_VERSION="v0.16.4"   # fixture 运行时
export HERTZ_RUNTIME_VERSION="v0.10.6"   # fixture 运行时
export GNOSTIC_VERSION="v0.7.0"          # openapiv3 annotations 的来源模块
export GRPC_GATEWAY_VERSION="v1.9.5"     # google/api annotations 的来源模块

# 需要走 tidy / build / test 的 fixture 模块，按依赖顺序排列（rpc_gen 在 app 之前）。
export FIXTURE_MODULES=(
  fixtures/kitex-greet/rpc_gen
  fixtures/kitex-greet/app/greet
  fixtures/hertz-greet/app/apigw
  fixtures/stream-sse/rpc_gen
  fixtures/stream-sse/app/echo
  fixtures/stream-sse/app/apigw
  fixtures/outbox-idempotency
)
